{
  "name": "taliup/taliup-php",
  "description": "Taliup PHP SDK",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "Taliup\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Taliup\\Sdk\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
