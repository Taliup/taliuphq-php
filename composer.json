{
  "name": "taliup/taliuphq-php",
  "description": "Official PHP SDK for the TaliupHQ API",
  "type": "library",
  "license": "MIT",
  "keywords": ["taliup", "payments", "hosted-payments", "payment-gateway"],
  "homepage": "https://taliup.ca",
  "authors": [
    {
      "name": "Taliup",
      "email": "support@taliuphq.ca",
      "homepage": "https://taliup.ca"
    }
  ],
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Taliup\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Taliup\\Sdk\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
